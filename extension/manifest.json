{
    "name": "New Tab Page with Countdown",
    "description": "Go home count down in new tab page",
    "version": "1.4",
    "incognito": "split",
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "permissions": ["storage"],
    "background": {
        "service_worker": "service-worker.js"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://tunglam7554.github.io;"
    },
    "manifest_version": 3
}
